# Electrochemical Analysis Suite - Environment Configuration
# =========================================================

# Data Storage Configuration
ELECTROCHEMICAL_DATA_DIR=test_data
ELECTROCHEMICAL_DB_NAME=test_database.db

# Web Interface Configuration  
WEB_PORT=5007
WEB_HOST=localhost
WEB_DEBUG=false

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=electrochemical.log
LOG_DIR=logs

# Processing Configuration
DEFAULT_TEMPERATURE_C=25.0
MAX_FILE_SIZE_MB=1000
PROCESSING_TIMEOUT_SECONDS=300

# Analysis Configuration
DECIMATION_THRESHOLD=10000
DEFAULT_DECIMATION_SAMPLES=1000

# Development Settings
DEV_MODE=false
AUTO_RELOAD=false